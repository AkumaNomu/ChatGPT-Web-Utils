{
  "manifest_version": 3,
  "name": "ChatGPT Mass Delete",
  "version": "1.5.0",
  "description": "Select multiple ChatGPT sidebar conversations and delete them all at once. Plus optional UI cleanup (Upgrade, disclaimer) and collapsible projects.",
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-mass-delete@example.com",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "settings.js",
        "content.js",
        "cleanup.js"
      ],
      "css": [
        "styles.css",
        "cleanup.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
