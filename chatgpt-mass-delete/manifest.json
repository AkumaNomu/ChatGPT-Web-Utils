{
  "manifest_version": 2,
  "name": "ChatGPT Mass Delete",
  "version": "1.1.1",
  "description": "Select multiple ChatGPT sidebar conversations and delete them all at once.",
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-mass-delete@example.com",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
